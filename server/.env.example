# Copier ce fichier en .env et remplir les clés. Ne jamais commiter .env.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
# IA qui rédige l'explication. Gratuit : gemini (aistudio.google.com) ou groq (console.groq.com).
# Payant : anthropic, openai.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Vide = modèle par défaut du fournisseur (voir phishguard_server/analysis/llm.py)
LLM_MODEL=
MONGODB_URI=
